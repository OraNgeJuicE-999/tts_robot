#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "jetracer"
    doc = """Generated from Composed Stage of root layer /tmp/tmpql7xs9um/jetracer.usdc


Generated from Composed Stage of root layer /home/itri/tts_robot/usdex/jetracer.usdc


Generated from Composed Stage of root layer /home/itri/tts_robot/temp/jetracer.usd


Generated from Composed Stage of root layer /home/itri/tts_robot/jetracer/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "jetracer"
{
    over "Physics"
    {
        def MjcActuator "front_left_base_holder_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target = </jetracer/Physics/front_left_base_holder>
        }

        def MjcActuator "front_left_wheel_holder_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target = </jetracer/Physics/front_left_wheel_holder>
        }

        def MjcActuator "front_right_base_holder_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target = </jetracer/Physics/front_right_base_holder>
        }

        def MjcActuator "front_right_wheel_holder_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target = </jetracer/Physics/front_right_wheel_holder>
        }

        def MjcActuator "rear_left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target = </jetracer/Physics/rear_left_wheel_joint>
        }

        def MjcActuator "rear_right_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target = </jetracer/Physics/rear_right_wheel_joint>
        }

