#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    doc = """Generated from Composed Stage of root layer /tmp/tmpql7xs9um/jetracer.usdc


Generated from Composed Stage of root layer /home/itri/tts_robot/usdex/jetracer.usdc


Generated from Composed Stage of root layer /home/itri/tts_robot/temp/jetracer.usd


Generated from Composed Stage of root layer /home/itri/tts_robot/jetracer/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "mount_red"
    {
        color3f inputs:diffuseColor = (1, 0, 0)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/mount_red/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/mount_red/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/mount_red.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/mount_red.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/mount_red.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/mount_red.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "camera_black"
    {
        color3f inputs:diffuseColor = (0, 0, 0)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/camera_black/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/camera_black/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/camera_black.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/camera_black.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/camera_black.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/camera_black.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "lidar_cyan"
    {
        color3f inputs:diffuseColor = (0, 0.6038274, 0.78741235)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/lidar_cyan/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/lidar_cyan/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/lidar_cyan.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/lidar_cyan.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/lidar_cyan.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/lidar_cyan.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
